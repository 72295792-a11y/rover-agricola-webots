# --- OBSTACULO DINAMICO ---
Robot {
  translation 0 -1.25 0.21
  children [
    SliderJoint {
      jointParameters JointParameters {
        axis 1 0 0
      }
      device [
        LinearMotor {
          name "slide_motor"
          maxForce 50
        }
      ]
      endPoint Solid {
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.85 0.15 0.15 roughness 0.5 metalness 0 }
            geometry Box { size 0.4 0.4 0.4 }
          }
        ]
        name "bloque_rojo"
        boundingObject Box { size 0.4 0.4 0.4 }
        physics Physics { density -1 mass 1.0 }
      }
    }
  ]
  name "obstaculo_movil"
  controller "obstaculo_movil"
}

# --- ROVER AGRICOLA 4x4 (PROTO PROPIO) ---
