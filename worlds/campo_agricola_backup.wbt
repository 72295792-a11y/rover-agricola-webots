# --- OBSTACULO DINAMICO ---
Robot {
  translation 0 -1.25 0.21
  children [
    SliderJoint {
      jointParameters JointParameters {
        axis 1 0 0
      }
      device [
        LinearMotor {
          name "slide_motor"
          maxForce 50
        }
      ]
      endPoint Solid {
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.85 0.15 0.15 roughness 0.5 metalness 0 }
            geometry Box { size 0.4 0.4 0.4 }
          }
        ]
        name "bloque_rojo"
        boundingObject Box { size 0.4 0.4 0.4 }
        physics Physics { density -1 mass 1.0 }
      }
    }
  ]
  name "obstaculo_movil"
  controller "obstaculo_movil"
}

# --- ROVER AGRICOLA 4x4 HECHO DESDE CERO ---
Robot {
  translation -3.5 -3.5 0.15
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.15 0.35 0.75 roughness 0.5 metalness 0.2 }
      geometry Box { size 0.5 0.35 0.15 }
    }
    Lidar {
      translation 0.15 0 0.12
      name "lidar"
      horizontalResolution 360
      fieldOfView 6.28318
      numberOfLayers 1
      maxRange 8
    }
    Camera {
      translation 0.25 0 0.12
      name "camera"
      width 320
      height 240
    }
    InertialUnit {
      translation 0 0 0.08
      name "imu"
    }
    GPS {
      translation 0 0 0.10
      name "gps_ground_truth"
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.18 0.22 -0.05 }
      device [ RotationalMotor { name "wheel_fl" } PositionSensor { name "enc_fl" } ]
      endPoint Solid {
        translation 0.18 0.22 -0.05
        rotation 1 0 0 1.5708
        children [ Shape { appearance PBRAppearance { baseColor 0.1 0.1 0.1 roughness 0.9 metalness 0 } geometry Cylinder { height 0.06 radius 0.1 } } ]
        name "wheel_fl_solid"
        boundingObject Cylinder { height 0.06 radius 0.1 }
        physics Physics { density -1 mass 0.5 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.18 -0.22 -0.05 }
      device [ RotationalMotor { name "wheel_fr" } PositionSensor { name "enc_fr" } ]
      endPoint Solid {
        translation 0.18 -0.22 -0.05
        rotation 1 0 0 1.5708
        children [ Shape { appearance PBRAppearance { baseColor 0.1 0.1 0.1 roughness 0.9 metalness 0 } geometry Cylinder { height 0.06 radius 0.1 } } ]
        name "wheel_fr_solid"
        boundingObject Cylinder { height 0.06 radius 0.1 }
        physics Physics { density -1 mass 0.5 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.18 0.22 -0.05 }
      device [ RotationalMotor { name "wheel_rl" } PositionSensor { name "enc_rl" } ]
      endPoint Solid {
        translation -0.18 0.22 -0.05
        rotation 1 0 0 1.5708
        children [ Shape { appearance PBRAppearance { baseColor 0.1 0.1 0.1 roughness 0.9 metalness 0 } geometry Cylinder { height 0.06 radius 0.1 } } ]
        name "wheel_rl_solid"
        boundingObject Cylinder { height 0.06 radius 0.1 }
        physics Physics { density -1 mass 0.5 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.18 -0.22 -0.05 }
      device [ RotationalMotor { name "wheel_rr" } PositionSensor { name "enc_rr" } ]
      endPoint Solid {
        translation -0.18 -0.22 -0.05
        rotation 1 0 0 1.5708
        children [ Shape { appearance PBRAppearance { baseColor 0.1 0.1 0.1 roughness 0.9 metalness 0 } geometry Cylinder { height 0.06 radius 0.1 } } ]
        name "wheel_rr_solid"
        boundingObject Cylinder { height 0.06 radius 0.1 }
        physics Physics { density -1 mass 0.5 }
      }
    }
  ]
  name "rover_agricola"
  boundingObject Box { size 0.5 0.35 0.15 }
  physics Physics { density -1 mass 5.0 }
  controller "rover_controller"
}
